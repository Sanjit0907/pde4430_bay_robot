<?xml version="1.0"?>
<!--
  test_world.sdf - small test arena for the bay robot (NOT the assessment world).
  Contains the Sensors system (needed for lidar + camera), a wall 1.5 m ahead,
  a red floor strip, and a test ball (r = 0.12 m) 0.6 m in front of the robot spawn.
-->
<sdf version="1.9">
  <world name="test">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- wall 1.5 m ahead for the lidar -->
    <model name="wall">
      <static>true</static>
      <pose>1.6 0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.1 2.0 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 2.0 0.5</size></box></geometry>
          <material><ambient>0.3 0.3 0.8 1</ambient><diffuse>0.3 0.3 0.8 1</diffuse></material></visual>
      </link>
    </model>

    <!-- red floor strip, like the bay opening marker -->
    <model name="strip">
      <static>true</static>
      <pose>1.2 0 0.001 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>0.1 1.0 0.002</size></box></geometry>
          <material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material></visual>
      </link>
    </model>

    <!-- test ball: 0.12 m radius, 0.5 kg, hollow-ish -->
    <model name="ball">
      <pose>0.6 0 0.12 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.5</mass>
          <inertia><ixx>0.0048</ixx><iyy>0.0048</iyy><izz>0.0048</izz></inertia>
        </inertial>
        <collision name="c"><geometry><sphere><radius>0.12</radius></sphere></geometry></collision>
        <visual name="v"><geometry><sphere><radius>0.12</radius></sphere></geometry>
          <material><ambient>0.1 0.7 0.1 1</ambient><diffuse>0.1 0.7 0.1 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
