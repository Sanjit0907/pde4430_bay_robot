<?xml version="1.0"?>
<!--
  bay_robot.urdf
  PDE4430 Mobile Robotics coursework - "Bay Pusher" robot for the assessment_bay world.

  Design (sized for the assessment_bay objects):
    large_sphere  d 0.60 m, 1.0 kg  - wider than the 0.5 m spawn footprint
    small_sphere  d 0.20 m, 0.3 kg
    cylinder      d 0.20 m x 0.40 m, CoM 0.20 m - tips if pushed above ~0.20 m

  * Differential-drive base, front + rear ball casters.
  * Low front BUMPER (0.02 - 0.24 m above the floor): pushes the cylinder below
    its centre of mass so it slides instead of tipping.
  * GRIPPER: two motorised fold-out JAWS (0.02 - 0.30 m high, 0.44 m long, a 0.40 m
    post at each tip, black rubber grip pads on the inner faces), pivoting about
    vertical axes at the bumper corners:
        folded (spawn)   q = 0.000 rad  jaws lie back along the sides -> fits 0.5 x 0.5 m
        wide             q = 2.094 rad  60 deg outward: funnel to catch an object
        large            q = 2.531 rad  35 deg outward: a V that cradles the 0.6 m sphere
                                         (1 cm play) so it stays centred while pushed
        close            q = 3.526 rad  22 deg inward: jaws meet in front and cage
                                         the small sphere or the cylinder (r 0.10 m)
        grip             q = 3.840 rad  40 deg inward target, deliberately PAST where the
                                         pads meet a 0.2 m object (~25-27 deg): the jaw
                                         motors stay at their effort limit, so the squeeze
                                         force is set by <limit effort> (5 N m), not by
                                         how far the jaws happen to be from the target
  * LIFT: both jaws ride on a carriage on a vertical prismatic joint (0 - 0.15 m), so a
    gripped small sphere or cylinder can be PICKED UP, carried and set down.
    Objects are held only by friction from squeezing - never attached. The 0.6 m
    sphere is wider than the robot and is pushed in the V instead.
  * LiDAR on a mast at 0.35 m: above the arms and bumper, below the 0.5 m bay walls,
    and high enough to see the 0.4 m cylinder.
  * Camera on a pole at 0.72 m, tilted down, so it can see over the large sphere.

  Footprint at spawn: 0.45 m (x) by 0.39 m (y).
  Convention (REP-103): x forward, y left, z up. base_footprint on the ground,
  base_link at wheel-axle height (0.05 m).
  Gazebo section at the bottom targets Gazebo Harmonic (ROS 2 Jazzy).
-->
<robot name="bay_robot">

  <!-- ===================== Materials (RViz colours) ===================== -->
  <material name="chassis_grey"><color rgba="0.25 0.27 0.30 1.0"/></material>
  <material name="bumper_orange"><color rgba="0.95 0.50 0.10 1.0"/></material>
  <material name="arm_yellow"><color rgba="0.98 0.78 0.15 1.0"/></material>
  <material name="wheel_black"><color rgba="0.08 0.08 0.08 1.0"/></material>
  <material name="sensor_blue"><color rgba="0.15 0.35 0.85 1.0"/></material>
  <material name="pole_grey"><color rgba="0.6 0.6 0.6 1.0"/></material>
  <material name="rubber_black"><color rgba="0.05 0.05 0.05 1.0"/></material>
  <material name="steel"><color rgba="0.78 0.80 0.83 1.0"/></material>
  <material name="carriage_dark"><color rgba="0.18 0.19 0.22 1.0"/></material>

  <!-- ===================== base_footprint (ground frame) ===================== -->
  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>  <!-- axle height = wheel radius -->
  </joint>

  <!-- ===================== Chassis ===================== -->
  <!-- Box 0.24 x 0.26 x 0.10, x = -0.16 .. +0.08, 0.025 - 0.125 m above the floor -->
  <link name="base_link">
    <visual>
      <origin xyz="-0.04 0 0.025" rpy="0 0 0"/>
      <geometry><box size="0.24 0.26 0.10"/></geometry>
      <material name="chassis_grey"/>
    </visual>
    <collision>
      <origin xyz="-0.04 0 0.025" rpy="0 0 0"/>
      <geometry><box size="0.24 0.26 0.10"/></geometry>
    </collision>
    <inertial>
      <origin xyz="-0.04 0 0.025" rpy="0 0 0"/>
      <mass value="4.0"/>
      <!-- solid box: Ixx = m/12 (y^2+z^2), Iyy = m/12 (x^2+z^2), Izz = m/12 (x^2+y^2) -->
      <inertia ixx="0.02587" ixy="0" ixz="0" iyy="0.02253" iyz="0" izz="0.04173"/>
    </inertial>
  </link>

  <!-- ===================== Ballast ===================== -->
  <!-- 2 kg battery pack low in the back of the chassis. It moves the centre of mass
       back, so the robot stays on its wheels with the tray and fingers out and the
       1 kg large sphere held 0.39 m in front (without it the robot tipped forward
       onto the tray tip as soon as the lift rose). -->
  <link name="ballast">
    <visual>
      <geometry><box size="0.08 0.20 0.06"/></geometry>
      <material name="carriage_dark"/>
    </visual>
    <inertial>
      <mass value="2.0"/>
      <!-- solid box: Ixx = m/12 (y^2+z^2), Iyy = m/12 (x^2+z^2), Izz = m/12 (x^2+y^2) -->
      <inertia ixx="0.00727" ixy="0" ixz="0" iyy="0.00167" iyz="0" izz="0.00773"/>
    </inertial>
  </link>
  <joint name="ballast_joint" type="fixed">
    <parent link="base_link"/>
    <child link="ballast"/>
    <!-- 0.11 m behind the wheels, inside the chassis -->
    <origin xyz="-0.11 0 0.02" rpy="0 0 0"/>
  </joint>

  <!-- ===================== Drive wheels (r 0.05, width 0.03, track 0.30) ===================== -->
  <link name="left_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.05" length="0.03"/></geometry>
      <material name="wheel_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.05" length="0.03"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <mass value="0.3"/>
      <!-- solid cylinder: Ixx = Iyy = m/12 (3r^2 + h^2), Izz = m r^2 / 2 -->
      <inertia ixx="0.000210" ixy="0" ixz="0" iyy="0.000210" iyz="0" izz="0.000375"/>
    </inertial>
  </link>
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="0 0.15 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.01" friction="0.0"/>
  </joint>

  <link name="right_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.05" length="0.03"/></geometry>
      <material name="wheel_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.05" length="0.03"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <mass value="0.3"/>
      <inertia ixx="0.000210" ixy="0" ixz="0" iyy="0.000210" iyz="0" izz="0.000375"/>
    </inertial>
  </link>
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="0 -0.15 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.01" friction="0.0"/>
  </joint>

  <!-- ===================== Casters (front + rear, frictionless balls) ===================== -->
  <!-- Radius 0.0245 with centre 0.025 m up: 0.5 mm above the floor, so the drive
       wheels always carry the weight (traction) while the casters stop pitching. -->
  <link name="rear_caster">
    <visual><geometry><sphere radius="0.0245"/></geometry><material name="wheel_black"/></visual>
    <collision><geometry><sphere radius="0.0245"/></geometry></collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.000024" ixy="0" ixz="0" iyy="0.000024" iyz="0" izz="0.000024"/>
    </inertial>
  </link>
  <joint name="rear_caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rear_caster"/>
    <origin xyz="-0.13 0 -0.025" rpy="0 0 0"/>
  </joint>

  <link name="front_caster">
    <visual><geometry><sphere radius="0.0245"/></geometry><material name="wheel_black"/></visual>
    <collision><geometry><sphere radius="0.0245"/></geometry></collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.000024" ixy="0" ixz="0" iyy="0.000024" iyz="0" izz="0.000024"/>
    </inertial>
  </link>
  <!-- Front caster right under the bumper (0.085 m ahead of the wheels): with the
       fingers and tray out and the large sphere held, the robot's centre of mass
       moves forward, and the further forward this support is, the more margin
       against tipping onto the nose. -->
  <joint name="front_caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_caster"/>
    <origin xyz="0.085 0 -0.025" rpy="0 0 0"/>
  </joint>

  <!-- ===================== Front bumper ===================== -->
  <!-- Plate 0.02 x 0.34 x 0.22, front face at x = 0.10, 0.02 - 0.24 m above the floor.
       Pushes the cylinder low (contact centroid ~0.13 m < CoM 0.20 m) and meets the
       large sphere just below its equator. -->
  <link name="bumper_link">
    <visual>
      <geometry><box size="0.02 0.34 0.22"/></geometry>
      <material name="bumper_orange"/>
    </visual>
    <collision>
      <geometry><box size="0.02 0.34 0.22"/></geometry>
    </collision>
    <inertial>
      <mass value="0.4"/>
      <inertia ixx="0.00547" ixy="0" ixz="0" iyy="0.00163" iyz="0" izz="0.00387"/>
    </inertial>
  </link>
  <joint name="bumper_joint" type="fixed">
    <parent link="base_link"/>
    <child link="bumper_link"/>
    <origin xyz="0.09 0 0.08" rpy="0 0 0"/>
  </joint>

  <!-- Rubber pad on the bumper face, 0.05 - 0.15 m above the floor, where the small
       sphere and cylinder are pressed when gripped. The angled jaws touch a sphere
       slightly ahead of its centre, so without grip here it can roll down and back
       between the pads. The large sphere touches the bumper higher (~0.24 m) and
       never reaches this pad. Separate link so it keeps its own friction. -->
  <link name="bumper_pad">
    <visual>
      <geometry><box size="0.006 0.14 0.10"/></geometry>
      <material name="rubber_black"/>
    </visual>
    <collision>
      <geometry><box size="0.006 0.14 0.10"/></geometry>
    </collision>
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.0000247" ixy="0" ixz="0" iyy="0.0000084" iyz="0" izz="0.0000164"/>
    </inertial>
  </link>
  <joint name="bumper_pad_joint" type="fixed">
    <parent link="bumper_link"/>
    <child link="bumper_pad"/>
    <origin xyz="0.013 0 -0.03" rpy="0 0 0"/>
  </joint>

  <!-- ===================== Lift: rails + carriage ===================== -->
  <!-- Two steel guide rails stand on the chassis just behind the bumper (0.125 - 0.31 m,
       ending below the LiDAR scan plane). Visual only. -->
  <link name="lift_rails">
    <visual>
      <origin xyz="0 0.155 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.008" length="0.185"/></geometry>
      <material name="steel"/>
    </visual>
    <visual>
      <origin xyz="0 -0.155 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.008" length="0.185"/></geometry>
      <material name="steel"/>
    </visual>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0003" ixy="0" ixz="0" iyy="0.0003" iyz="0" izz="0.00001"/>
    </inertial>
  </link>
  <joint name="lift_rails_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lift_rails"/>
    <origin xyz="0.07 0 0.1675" rpy="0 0 0"/>
  </joint>

  <!-- Carriage: a crossbar on the rails (behind the bumper, 0.26 - 0.29 m) joined to two
       hinge housings at the jaw pivots. The jaws hang from it, so raising the carriage
       lifts both jaws and whatever they are gripping. Visual only (the jaws themselves
       do all the contact work), but it carries the jaws' joints and mass. -->
  <link name="lift_carriage">
    <visual>
      <origin xyz="0.005 0 0.125" rpy="0 0 0"/>
      <geometry><box size="0.02 0.40 0.03"/></geometry>
      <material name="carriage_dark"/>
    </visual>
    <visual>
      <origin xyz="0.03 0.185 0.02" rpy="0 0 0"/>
      <geometry><cylinder radius="0.018" length="0.30"/></geometry>
      <material name="carriage_dark"/>
    </visual>
    <visual>
      <origin xyz="0.03 -0.185 0.02" rpy="0 0 0"/>
      <geometry><cylinder radius="0.018" length="0.30"/></geometry>
      <material name="carriage_dark"/>
    </visual>
    <inertial>
      <origin xyz="0.02 0 0.06" rpy="0 0 0"/>
      <mass value="0.4"/>
      <!-- approximated as a 0.04 x 0.40 x 0.30 box -->
      <inertia ixx="0.00833" ixy="0" ixz="0" iyy="0.00305" iyz="0" izz="0.00539"/>
    </inertial>
  </link>
  <joint name="lift_joint" type="prismatic">
    <parent link="base_link"/>
    <child link="lift_carriage"/>
    <!-- carriage frame at the rails (x 0.07), at jaw-pivot height (0.16 m above floor) -->
    <origin xyz="0.07 0 0.11" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="0.0" upper="0.15" effort="100.0" velocity="0.2"/>
    <dynamics damping="5.0" friction="0.0"/>
  </joint>

  <!-- ===================== Gripper jaws ===================== -->
  <!-- Each arm: plate 0.44 long x 0.02 thick x 0.28 high (0.02 - 0.30 m above floor).
       In the arm frame the plate extends along -x from the pivot, so at q = 0 the arm
       points backwards (folded). The left joint turns about -z and the right about +z,
       so the SAME positive angle opens both arms symmetrically:
       arm direction = 180 deg - q, measured outward from straight ahead. -->
  <link name="left_arm">
    <!-- arm plate -->
    <visual>
      <origin xyz="-0.22 0 0" rpy="0 0 0"/>
      <geometry><box size="0.44 0.02 0.28"/></geometry>
      <material name="arm_yellow"/>
    </visual>
    <collision>
      <origin xyz="-0.22 0 0" rpy="0 0 0"/>
      <geometry><box size="0.44 0.02 0.28"/></geometry>
    </collision>
    <!-- tip post, 0.02 - 0.40 m above the floor: the large sphere's equator (0.30 m)
         meets its flat side, so the push is horizontal. With the plate alone the
         sphere met the plate's top edge exactly at its equator and climbed over it. -->
    <visual>
      <origin xyz="-0.43 0 0.05" rpy="0 0 0"/>
      <geometry><box size="0.03 0.03 0.38"/></geometry>
      <material name="arm_yellow"/>
    </visual>
    <collision>
      <origin xyz="-0.43 0 0.05" rpy="0 0 0"/>
      <geometry><box size="0.03 0.03 0.38"/></geometry>
    </collision>
    <inertial>
      <origin xyz="-0.25 0 0" rpy="0 0 0"/>
      <mass value="0.35"/>
      <!-- plate + post, approximated -->
      <inertia ixx="0.00270" ixy="0" ixz="0" iyy="0.00910" iyz="0" izz="0.00710"/>
    </inertial>
  </link>
  <joint name="left_arm_joint" type="revolute">
    <parent link="lift_carriage"/>
    <child link="left_arm"/>
    <origin xyz="0.03 0.185 0" rpy="0 0 0"/>  <!-- = (0.10, 0.185) from base_link -->
    <axis xyz="0 0 -1"/>
    <!-- effort = squeeze torque: 5 N m = ~25 N at a pad 0.2 m out, ~5x what the
         0.5 kg cylinder needs (mu 0.5); harder squeezes jammed the physics solver -->
    <limit lower="0.0" upper="3.9" effort="5.0" velocity="2.0"/>
    <dynamics damping="0.5" friction="0.0"/>
  </joint>

  <link name="right_arm">
    <visual>
      <origin xyz="-0.22 0 0" rpy="0 0 0"/>
      <geometry><box size="0.44 0.02 0.28"/></geometry>
      <material name="arm_yellow"/>
    </visual>
    <collision>
      <origin xyz="-0.22 0 0" rpy="0 0 0"/>
      <geometry><box size="0.44 0.02 0.28"/></geometry>
    </collision>
    <visual>
      <origin xyz="-0.43 0 0.05" rpy="0 0 0"/>
      <geometry><box size="0.03 0.03 0.38"/></geometry>
      <material name="arm_yellow"/>
    </visual>
    <collision>
      <origin xyz="-0.43 0 0.05" rpy="0 0 0"/>
      <geometry><box size="0.03 0.03 0.38"/></geometry>
    </collision>
    <inertial>
      <origin xyz="-0.25 0 0" rpy="0 0 0"/>
      <mass value="0.35"/>
      <inertia ixx="0.00270" ixy="0" ixz="0" iyy="0.00910" iyz="0" izz="0.00710"/>
    </inertial>
  </link>
  <joint name="right_arm_joint" type="revolute">
    <parent link="lift_carriage"/>
    <child link="right_arm"/>
    <origin xyz="0.03 -0.185 0" rpy="0 0 0"/>  <!-- = (0.10, -0.185) from base_link -->
    <axis xyz="0 0 1"/>
    <limit lower="0.0" upper="3.9" effort="5.0" velocity="2.0"/>
    <dynamics damping="0.5" friction="0.0"/>
  </joint>

  <!-- ===================== Grip pads ===================== -->
  <!-- Black rubber pads (mu 1.5) on the jaws' inner faces, 0.05 - 0.20 m above the floor
       (around the small sphere's equator and low on the cylinder). Each pad is turned
       27 deg on its jaw, so that when the jaws close on a 0.2 m object (they stop at about
       27 deg inward) the two pad faces are PARALLEL and press straight across the object's
       middle - like a parallel-jaw gripper. With flat pads, the angled jaws pressed a sphere
       slightly ahead of its centre and it rolled backwards out of the grip.
       Placement solved for a 0.2 m object centred 0.21 m ahead: pad centre 0.134 m along the
       jaw and 0.020 m in from its axis. Separate links on fixed joints that are not merged
       (preserveFixedJoint), so they keep their own friction while the jaws stay slippery. -->
  <link name="left_pad">
    <visual>
      <geometry><box size="0.12 0.012 0.15"/></geometry>
      <material name="rubber_black"/>
    </visual>
    <collision>
      <geometry><box size="0.12 0.012 0.15"/></geometry>
    </collision>
    <inertial>
      <mass value="0.02"/>
      <inertia ixx="0.0000378" ixy="0" ixz="0" iyy="0.0000615" iyz="0" izz="0.0000242"/>
    </inertial>
  </link>
  <joint name="left_pad_joint" type="fixed">
    <parent link="left_arm"/>
    <child link="left_pad"/>
    <origin xyz="-0.134 0.020 -0.035" rpy="0 0 0.4712"/>
  </joint>

  <link name="right_pad">
    <visual>
      <geometry><box size="0.12 0.012 0.15"/></geometry>
      <material name="rubber_black"/>
    </visual>
    <collision>
      <geometry><box size="0.12 0.012 0.15"/></geometry>
    </collision>
    <inertial>
      <mass value="0.02"/>
      <inertia ixx="0.0000378" ixy="0" ixz="0" iyy="0.0000615" iyz="0" izz="0.0000242"/>
    </inertial>
  </link>
  <joint name="right_pad_joint" type="fixed">
    <parent link="right_arm"/>
    <child link="right_pad"/>
    <origin xyz="-0.134 -0.020 -0.035" rpy="0 0 -0.4712"/>
  </joint>

  <!-- ===================== Scoop tray (ramp) ===================== -->
  <!-- A thin tray hinged at the foot of the bumper, on the lift carriage. Folded up
       (q = 0) it stands upright in front of the bumper, so the robot still fits the
       0.5 m spawn square. Deployed (q = pi/2) it lies flat, 0.36 m long, with a
       bevelled tip only 2 mm above the floor - like a dustpan. Driving into a sphere,
       the tip slides under it: the tip touches the sphere so low that the contact
       pushes it UP rather than forward, so it rolls onto the tray and back against
       the bumper. Because the tray rides on the lift, raising the lift raises
       whatever sits on it.
       Link frame at the hinge, geometry drawn FOLDED (tray along +z). Deployed, link
       +z points forward and link -x points up, so the tray's upper face is its -x face.
       Deployed heights above the floor: hinge 0.010, tray top 0.016, tip top 0.004,
       tip underside 0.0015. Reaches 0.59 m ahead of the robot centre. Low and gentle
       (a 7 deg tip), so little push is needed to roll a sphere up onto it. -->
  <link name="scoop">
    <!-- tray plate: 0.36 long, 0.30 wide, 6 mm thick -->
    <visual>
      <origin xyz="-0.003 0 0.185" rpy="0 0 0"/>
      <geometry><box size="0.006 0.30 0.36"/></geometry>
      <material name="steel"/>
    </visual>
    <collision>
      <origin xyz="-0.003 0 0.185" rpy="0 0 0"/>
      <geometry><box size="0.006 0.30 0.36"/></geometry>
    </collision>
    <!-- bevelled tip: 0.10 long, 2.5 mm thick, sloping 7 deg from the tray top down
         to 4 mm above the floor -->
    <visual>
      <origin xyz="0.00124 0 0.41485" rpy="0 0.1194 0"/>
      <geometry><box size="0.0025 0.30 0.1007"/></geometry>
      <material name="steel"/>
    </visual>
    <collision>
      <origin xyz="0.00124 0 0.41485" rpy="0 0.1194 0"/>
      <geometry><box size="0.0025 0.30 0.1007"/></geometry>
    </collision>
    <!-- rubber pad on the underside near the hinge: when the tray is folded it faces
         forward at the height of the bumper pad, and takes over its job (the folded
         tray covers the bumper pad) -->
    <visual>
      <origin xyz="0.002 0 0.09" rpy="0 0 0"/>
      <geometry><box size="0.004 0.14 0.10"/></geometry>
      <material name="rubber_black"/>
    </visual>
    <collision>
      <origin xyz="0.002 0 0.09" rpy="0 0 0"/>
      <geometry><box size="0.004 0.14 0.10"/></geometry>
    </collision>
    <inertial>
      <origin xyz="-0.002 0 0.23" rpy="0 0 0"/>
      <mass value="0.4"/>
      <!-- approximated as a 0.006 x 0.30 x 0.46 box -->
      <inertia ixx="0.01005" ixy="0" ixz="0" iyy="0.00705" iyz="0" izz="0.0030"/>
    </inertial>
  </link>
  <joint name="scoop_joint" type="revolute">
    <parent link="lift_carriage"/>
    <child link="scoop"/>
    <!-- hinge 0.128 m ahead of the robot centre, 0.010 m above the floor -->
    <origin xyz="0.058 0 -0.150" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <!-- deployed it rests on its upper limit (the controller pushes past it), so the
         weight on the tray is carried by the joint stop, not the controller -->
    <limit lower="0.0" upper="1.5708" effort="10.0" velocity="1.5"/>
    <dynamics damping="0.5" friction="0.0"/>
  </joint>

  <!-- ===================== Hook fingers ===================== -->
  <!-- A 0.35 m finger hinged at each jaw tip, 0.25 - 0.40 m above the floor, with
       three positions (angle relative to its jaw; Gazebo spawns joints at 0, so 0
       must be the folded one):
         fold      0 deg  lies flat back along the jaw (spawn, and for the small
                          objects), on the jaw side that faces outwards at spawn
         hook     90 deg  at right angles to the jaw, pointing inwards
         open    180 deg  straight on from the jaw, so jaw + finger reach 0.79 m
       Why: the large sphere (0.6 m) is wider than the jaw pivots (0.37 m apart), so
       the jaws alone can only touch it BEHIND its middle, and squeezing there pushes
       it forward. And the scoop tray cannot slide under a free sphere: its tip only
       nudges it, and it rolls away. So, with the jaws in the 35 deg V ('large'), the
       robot stops with the sphere just ahead of the tray tip and the OPEN fingers
       reaching past its front. Swinging to HOOK, the fingers sweep round the front of
       the sphere and push it backwards: up the tray tip (the only way it can go) onto
       the tray, and against the bumper. Hooked, each finger touches the sphere's front
       side at its equator, ~35 deg off straight ahead, and keeps pressing it back and
       inwards: the sphere is locked between the bumper, the jaws and the fingers,
       sitting on the tray, and the lift can raise it.
       Geometry: the tangent from the jaw tip (0.46, 0.44) to the sphere sitting on the
       tray against the bumper (centre 0.39 m ahead, r 0.30 + half the finger
       thickness) runs at 90 deg to the jaw and touches 0.32 m along the finger.
       Going from open (180) to hook (90) the finger sweeps inwards round the front
       of the sphere, which is what pushes it onto the tray. -->
  <link name="left_finger">
    <visual>
      <origin xyz="0.175 0 0.165" rpy="0 0 0"/>
      <geometry><box size="0.35 0.02 0.15"/></geometry>
      <material name="arm_yellow"/>
    </visual>
    <collision>
      <origin xyz="0.175 0 0.165" rpy="0 0 0"/>
      <geometry><box size="0.35 0.02 0.15"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.175 0 0.165" rpy="0 0 0"/>
      <mass value="0.15"/>
      <inertia ixx="0.000286" ixy="0" ixz="0" iyy="0.00181" iyz="0" izz="0.00154"/>
    </inertial>
  </link>
  <joint name="left_finger_joint" type="revolute">
    <parent link="left_arm"/>
    <child link="left_finger"/>
    <!-- at the jaw tip, beside the plate on its +y side (the side that faces inwards
         when deployed): 0 = folded back along the jaw (+x), 90 deg = hooked inwards
         (jaw +y), 180 deg = straight on -->
    <origin xyz="-0.44 0.02 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.1" upper="3.25" effort="3.0" velocity="2.0"/>
    <dynamics damping="0.3" friction="0.0"/>
  </joint>
  <link name="right_finger">
    <visual>
      <origin xyz="0.175 0 0.165" rpy="0 0 0"/>
      <geometry><box size="0.35 0.02 0.15"/></geometry>
      <material name="arm_yellow"/>
    </visual>
    <collision>
      <origin xyz="0.175 0 0.165" rpy="0 0 0"/>
      <geometry><box size="0.35 0.02 0.15"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.175 0 0.165" rpy="0 0 0"/>
      <mass value="0.15"/>
      <inertia ixx="0.000286" ixy="0" ixz="0" iyy="0.00181" iyz="0" izz="0.00154"/>
    </inertial>
  </link>
  <joint name="right_finger_joint" type="revolute">
    <parent link="right_arm"/>
    <child link="right_finger"/>
    <origin xyz="-0.44 -0.02 0" rpy="0 0 0"/>
    <axis xyz="0 0 -1"/>
    <limit lower="-0.1" upper="3.25" effort="3.0" velocity="2.0"/>
    <dynamics damping="0.3" friction="0.0"/>
  </joint>

  <!-- ===================== LiDAR mast ===================== -->
  <!-- Mast 0.04 x 0.04, from the chassis top (0.125 m) to 0.325 m -->
  <link name="mast_link">
    <visual><geometry><box size="0.04 0.04 0.20"/></geometry><material name="pole_grey"/></visual>
    <collision><geometry><box size="0.04 0.04 0.20"/></geometry></collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.000693" ixy="0" ixz="0" iyy="0.000693" iyz="0" izz="0.0000533"/>
    </inertial>
  </link>
  <joint name="mast_joint" type="fixed">
    <parent link="base_link"/>
    <child link="mast_link"/>
    <origin xyz="-0.08 0 0.175" rpy="0 0 0"/>
  </joint>

  <!-- 2D LiDAR: scan plane 0.35 m above the floor (sees bay walls 0.5 m, obstacles,
       cylinder 0.4 m and large sphere; the 0.2 m small sphere is found by camera) -->
  <link name="lidar_link">
    <visual><geometry><cylinder radius="0.04" length="0.05"/></geometry><material name="sensor_blue"/></visual>
    <collision><geometry><cylinder radius="0.04" length="0.05"/></geometry></collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.000122" ixy="0" ixz="0" iyy="0.000122" iyz="0" izz="0.00016"/>
    </inertial>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="-0.08 0 0.30" rpy="0 0 0"/>
  </joint>

  <!-- ===================== Camera pole + camera ===================== -->
  <!-- Thin pole behind the LiDAR (0.07 m away: inside the LiDAR's 0.12 m minimum
       range, so it does not show up in scans), 0.125 - 0.70 m above the floor -->
  <link name="camera_pole">
    <visual><geometry><box size="0.02 0.02 0.575"/></geometry><material name="pole_grey"/></visual>
    <collision><geometry><box size="0.02 0.02 0.575"/></geometry></collision>
    <inertial>
      <mass value="0.15"/>
      <inertia ixx="0.00413" ixy="0" ixz="0" iyy="0.00413" iyz="0" izz="0.00001"/>
    </inertial>
  </link>
  <joint name="camera_pole_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_pole"/>
    <origin xyz="-0.15 0 0.3625" rpy="0 0 0"/>
  </joint>

  <!-- Camera 0.72 m up, pitched down 0.55 rad (~31 deg): sees the jaws and, over the
       top of the large sphere, the floor further ahead (yellow strip, objects) -->
  <link name="camera_link">
    <visual><geometry><box size="0.03 0.06 0.03"/></geometry><material name="sensor_blue"/></visual>
    <collision><geometry><box size="0.03 0.06 0.03"/></geometry></collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.000019" ixy="0" ixz="0" iyy="0.0000075" iyz="0" izz="0.000019"/>
    </inertial>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="-0.13 0 0.67" rpy="0 0.55 0"/>
  </joint>

  <!-- Optical frame: z forward, x right, y down (what image consumers expect) -->
  <link name="camera_optical_link"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_link"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>

  <!-- =====================================================================
       GAZEBO (Harmonic / gz-sim) - physics, plugins and sensors
       ===================================================================== -->

  <!-- Friction: grippy wheels, frictionless casters; low-friction bumper and arms so
       objects slide along them into the centre instead of being dragged sideways -->
  <gazebo reference="left_wheel"><mu1>1.0</mu1><mu2>1.0</mu2></gazebo>
  <gazebo reference="right_wheel"><mu1>1.0</mu1><mu2>1.0</mu2></gazebo>
  <gazebo reference="rear_caster"><mu1>0.0</mu1><mu2>0.0</mu2></gazebo>
  <gazebo reference="front_caster"><mu1>0.0</mu1><mu2>0.0</mu2></gazebo>
  <gazebo reference="bumper_link"><mu1>0.3</mu1><mu2>0.3</mu2></gazebo>
  <gazebo reference="left_arm"><mu1>0.1</mu1><mu2>0.1</mu2></gazebo>
  <gazebo reference="right_arm"><mu1>0.1</mu1><mu2>0.1</mu2></gazebo>
  <!-- grip pads: high-friction rubber, kept as separate links -->
  <gazebo reference="left_pad"><mu1>1.5</mu1><mu2>1.5</mu2></gazebo>
  <gazebo reference="right_pad"><mu1>1.5</mu1><mu2>1.5</mu2></gazebo>
  <gazebo reference="bumper_pad"><mu1>1.2</mu1><mu2>1.2</mu2></gazebo>
  <gazebo reference="bumper_pad_joint"><preserveFixedJoint>true</preserveFixedJoint></gazebo>
  <gazebo reference="left_pad_joint"><preserveFixedJoint>true</preserveFixedJoint></gazebo>
  <gazebo reference="right_pad_joint"><preserveFixedJoint>true</preserveFixedJoint></gazebo>
  <!-- scoop tray: low friction, so objects slide/roll onto it easily; its rubber pad
       (used when folded) is part of the same link, so it gets the tray's friction -->
  <gazebo reference="scoop"><mu1>0.4</mu1><mu2>0.4</mu2></gazebo>
  <!-- fingers: slippery, so the sphere they push can roll along them up onto the
       tray. They hold it by where they are (in front of it), not by friction. -->
  <gazebo reference="left_finger"><mu1>0.2</mu1><mu2>0.2</mu2></gazebo>
  <gazebo reference="right_finger"><mu1>0.2</mu1><mu2>0.2</mu2></gazebo>

  <gazebo>
    <!-- Differential drive: /cmd_vel (geometry_msgs/Twist) in, /odom + TF out.
         Gentle acceleration limits so pushed objects are not flung ahead. -->
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.30</wheel_separation>
      <wheel_radius>0.05</wheel_radius>
      <max_linear_acceleration>0.5</max_linear_acceleration>
      <max_angular_acceleration>1.5</max_angular_acceleration>
      <max_linear_velocity>0.5</max_linear_velocity>
      <max_angular_velocity>1.5</max_angular_velocity>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <tf_topic>tf</tf_topic>
      <odom_publish_frequency>30</odom_publish_frequency>
    </plugin>

    <!-- Arm position controllers: std_msgs/Float64 angle (rad) on
         /left_arm/cmd_pos and /right_arm/cmd_pos (0 = folded, see table above).
         Force (PID) mode: the joint torque is p_gain * error + d_gain * error rate,
         capped at cmd_max N m. The cap equals the joint effort (5 N m), so the grip
         squeeze stays the same. p 60: stiff enough that the jaws hold their V while the
         fingers push the large sphere (at p 20 they gave way by 12 deg), and in 'grip'
         (13 deg past contact) the squeeze reaches the full 5 N m. (Velocity-command mode stopped moving the jaws after
         a Gazebo update; README section 7, tuning step 6.) -->
    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>left_arm_joint</joint_name>
      <topic>left_arm/cmd_pos</topic>
      <p_gain>60</p_gain>
      <i_gain>0</i_gain>
      <d_gain>4</d_gain>
      <cmd_max>5</cmd_max>
      <cmd_min>-5</cmd_min>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>right_arm_joint</joint_name>
      <topic>right_arm/cmd_pos</topic>
      <p_gain>60</p_gain>
      <i_gain>0</i_gain>
      <d_gain>4</d_gain>
      <cmd_max>5</cmd_max>
      <cmd_min>-5</cmd_min>
    </plugin>

    <!-- Scoop tray: std_msgs/Float64 angle (rad) on /scoop/cmd_pos, 0 = folded up,
         pi/2 = flat. Force (PID) mode. Deployed, arm_controller asks for a little past
         pi/2, so the tray rests on its joint stop. -->
    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>scoop_joint</joint_name>
      <topic>scoop/cmd_pos</topic>
      <p_gain>40</p_gain>
      <i_gain>0</i_gain>
      <d_gain>3</d_gain>
      <cmd_max>10</cmd_max>
      <cmd_min>-10</cmd_min>
    </plugin>

    <!-- Hook fingers: both follow /fingers/cmd_pos (the joints are mirrored, so the
         same angle moves both alike). 0 = folded, pi/2 = hooked, pi = open. Force
         (PID) mode, capped at the 3 N m joint effort: hooked, arm_controller asks for
         less than 90 deg (past where they meet the sphere), so the fingers keep
         pressing it with a steady force. -->
    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>left_finger_joint</joint_name>
      <topic>fingers/cmd_pos</topic>
      <p_gain>15</p_gain>
      <i_gain>0</i_gain>
      <d_gain>1</d_gain>
      <cmd_max>3</cmd_max>
      <cmd_min>-3</cmd_min>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>right_finger_joint</joint_name>
      <topic>fingers/cmd_pos</topic>
      <p_gain>15</p_gain>
      <i_gain>0</i_gain>
      <d_gain>1</d_gain>
      <cmd_max>3</cmd_max>
      <cmd_min>-3</cmd_min>
    </plugin>

    <!-- Lift: std_msgs/Float64 height (m, 0 - 0.15) on /lift/cmd_pos -->
    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>lift_joint</joint_name>
      <topic>lift/cmd_pos</topic>
      <!-- force (PID) mode: the lift carries the jaws' weight, so it is driven with a
           force that holds it against gravity (velocity mode did not move it) -->
      <p_gain>3000</p_gain>
      <i_gain>500</i_gain>
      <d_gain>150</d_gain>
      <i_max>45</i_max>
      <i_min>-45</i_min>
      <!-- force cap: ~2.5x the heaviest lifted weight (carriage, jaws, fingers, scoop
           tray and the 1 kg large sphere ~ 28 N), so it lifts smoothly instead of
           jerking the object -->
      <cmd_max>70</cmd_max>
      <cmd_min>-70</cmd_min>
    </plugin>

    <!-- Wheel, jaw and lift positions on /joint_states -->
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
      <!-- 50 Hz: by default it publishes every physics step (~1 kHz), which
           robot_state_publisher turns into ~1 kHz of /tf - more than Python nodes
           using TF (e.g. bay_detector) can keep up with -->
      <update_rate>50</update_rate>
    </plugin>
  </gazebo>

  <!-- 2D LiDAR: 360 samples, 0.12 - 8 m, /scan -->
  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <topic>scan</topic>
      <gz_frame_id>lidar_link</gz_frame_id>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range><min>0.12</min><max>8.0</max><resolution>0.01</resolution></range>
        <noise><type>gaussian</type><mean>0.0</mean><stddev>0.01</stddev></noise>
      </lidar>
    </sensor>
  </gazebo>

  <!-- RGB camera: 640x480 @ 15 Hz, /camera/image_raw -->
  <gazebo reference="camera_link">
    <sensor name="camera" type="camera">
      <topic>camera/image_raw</topic>
      <gz_frame_id>camera_optical_link</gz_frame_id>
      <update_rate>15</update_rate>
      <always_on>true</always_on>
      <camera>
        <horizontal_fov>1.3963</horizontal_fov>
        <image><width>640</width><height>480</height><format>R8G8B8</format></image>
        <clip><near>0.05</near><far>12.0</far></clip>
      </camera>
    </sensor>
  </gazebo>

</robot>
